rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMentor() {
      return signedIn()
        && exists(/databases/$(database)/documents/mentors/$(request.auth.uid));
    }
    // A mentors doc without a 'level' field is a full mentor; level 'signer'
    // may sign entries but not delete them or remove signatures.
    function isFullMentor() {
      return isMentor()
        && get(/databases/$(database)/documents/mentors/$(request.auth.uid))
             .data.get('level', 'full') == 'full';
    }

    // Staff list. Only editable in the Firebase console — never from the app.
    match /mentors/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Student profiles. A student may only create themself as role 'student'
    // and may only edit their own personal fields — never their role.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMentor());
      allow list: if isMentor();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow update: if isMentor()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'sno', 'idno', 'mentor', 'prog', 'saqa']));
      allow delete: if false;
    }

    // Programme targets are issued by the college: mentors write, students read.
    match /targets/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMentor());
      allow list: if isMentor();
      allow create, update: if isMentor();
      allow delete: if false;
    }

    // Logbook entries. Students see and write only their own; a signed entry
    // is locked for the student. Mentors see everything and may correct.
    match /entries/{entryId} {
      allow read: if signedIn()
        && (isMentor() || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isFullMentor()
        || (isMentor() && resource.data.signed == null
            && request.resource.data.uid == resource.data.uid)
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.signed == null
            && request.resource.data.uid == request.auth.uid);
      allow delete: if isFullMentor()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.signed == null);
    }
  }
}
