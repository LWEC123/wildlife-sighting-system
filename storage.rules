rules_version = '2';
// Firebase Storage rules for the LWEC Learning Portal (paste into Firebase console →
// Storage → Rules). Only students' own evidence uploads live here.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isMentor() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/mentors/$(request.auth.uid));
    }
    function enrolled() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/enrol/$('us335815_' + request.auth.uid))
        && firestore.get(/databases/(default)/documents/enrol/$('us335815_' + request.auth.uid)).data.active == true;
    }

    // evidence/<student uid>/<qualification>/<unit standard>/<file>
    match /evidence/{uid}/{rest=**} {
      allow read: if isMentor() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && enrolled()
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('application/vnd\\.(ms-powerpoint|openxmlformats-officedocument\\..*)')
            || request.resource.contentType.matches('application/msword'));
      // Files are never deleted from the app once uploaded (evidence integrity).
      allow delete: if false;
      allow update: if false;
    }

    // Course files (guides, presentations, videos, tests, answer sheets). Uploaded by
    // full mentors from Course setup. A student only ever receives the link of a module
    // they have unlocked; never upload assessor memos.
    match /course/{cid}/{rest=**} {
      allow read: if isMentor() || enrolled();
      allow write: if isMentor()
        && firestore.get(/databases/(default)/documents/mentors/$(request.auth.uid)).data.get('level', 'full') == 'full'
        && request.resource.size < 1024 * 1024 * 1024;
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
